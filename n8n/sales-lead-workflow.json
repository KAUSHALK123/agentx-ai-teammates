    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\n\nconst requiredFields = [\n  \"task_id\",\n  \"lead_id\",\n  \"name\",\n  \"email\",\n  \"company\",\n  \"request\"\n];\n\nconst missingFields = requiredFields.filter(\n  field => !String(lead[field] ?? \"\").trim()\n);\n\nconst qualified = missingFields.length === 0;\n\nreturn [{\n  json: {\n    task_id: lead.task_id,\n    lead_id: lead.lead_id,\n    name: lead.name,\n    email: lead.email,\n    company: lead.company,\n    request: lead.request,\n    qualification_status: qualified ? \"qualified\" : \"needs_information\",\n    missing_fields: missingFields\n  }\n}];"
      },
