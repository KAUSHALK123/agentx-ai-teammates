# AgentX Backend Configuration Example

# Environment: development, staging, production
AGENTX_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration (Gemini API)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database / Storage (Prepared for Supabase in later phase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key

# n8n Workflow Automation
N8N_BASE_URL=http://localhost:5678
N8N_SALES_WEBHOOK_URL=http://localhost:5678/webhook/agentx-sales-process-lead
N8N_SUPPORT_WEBHOOK_URL=http://localhost:5678/webhook/agentx-support-handle-issue
N8N_OPERATIONS_WEBHOOK_URL=http://localhost:5678/webhook/agentx-operations-daily-check
# N8N_API_KEY=your_n8n_api_key_if_configured
N8N_WEBHOOK_TIMEOUT_SECONDS=10.0
N8N_TIMEOUT_SECONDS=10.0
N8N_RETRY_ATTEMPTS=2

# Cognee Knowledge Base Engine Configuration
COGNEE_DATA_DIR=backend/app/knowledge/data
COGNEE_DATASET_NAME=demo_business_knowledge
COGNEE_EMBEDDING_PROVIDER=fastembed
COGNEE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COGNEE_VECTOR_DB_PROVIDER=lancedb
COGNEE_LLM_PROVIDER=gemini
