# AgentX Backend Configuration Example

# Environment: development, staging, production
AGENTX_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration (Groq API)
LLM_PROVIDER=grok
GROK_API_KEY=your_groq_or_xai_api_key_here
GROK_MODEL=openai/gpt-oss-120b
GROK_BASE_URL=https://api.groq.com/openai/v1

# n8n Automation Engine & Webhooks
N8N_BASE_URL=http://localhost:5678
N8N_SALES_WEBHOOK_URL=http://localhost:5678/webhook/agentx-sales-process-lead
N8N_SUPPORT_WEBHOOK_URL=http://localhost:5678/webhook/agentx-support-handle-issue
N8N_OPERATIONS_WEBHOOK_URL=http://localhost:5678/webhook/agentx-operations-daily-check
N8N_GMAIL_WEBHOOK_URL=http://localhost:5678/webhook/agentx-gmail-send-approved-email
N8N_CRM_WEBHOOK_URL=http://localhost:5678/webhook/agentx-crm-lead-actions
N8N_SUPPORT_CASE_WEBHOOK_URL=http://localhost:5678/webhook/agentx-support-case-actions
N8N_WEBHOOK_TIMEOUT_SECONDS=10.0
N8N_RETRY_ATTEMPTS=2

# Cognee Cloud Knowledge Layer
COGNEE_MODE=cloud
COGNEE_SERVICE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=
COGNEE_DATASET_NAME=agentx-demo
COGNEE_TIMEOUT_SECONDS=15.0
COGNEE_DATA_DIR=backend/app/knowledge/data
