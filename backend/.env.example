# AgentX Environment Configuration Template
# Copy this file to .env and configure for local or production deployment.

# Application Environment: development | production
APP_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration (Groq API / Gemini API)
LLM_PROVIDER=grok
GROK_API_KEY=your_groq_or_xai_api_key_here
GROK_MODEL=openai/gpt-oss-120b
GROK_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# n8n Workflow Integration Configuration
# For Local Docker Dev: N8N_BASE_URL=http://localhost:32768
# For Hosted n8n Cloud: N8N_BASE_URL=https://your-instance.n8n.cloud
N8N_BASE_URL=http://localhost:32768

# Workflow Webhook URLs (Specify hosted n8n Cloud webhook endpoints for production)
N8N_SALES_WEBHOOK_URL=
N8N_SUPPORT_WEBHOOK_URL=
N8N_OPERATIONS_WEBHOOK_URL=
N8N_GMAIL_WEBHOOK_URL=
N8N_CRM_WEBHOOK_URL=
N8N_SUPPORT_CASE_WEBHOOK_URL=

# Optional n8n API key if header authentication is required by your n8n instance
N8N_API_KEY=

# Webhook request timeout in seconds (default: 30)
N8N_TIMEOUT_SECONDS=30

# Cognee Cloud Knowledge Layer
COGNEE_MODE=cloud
COGNEE_SERVICE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=
COGNEE_DATASET_NAME=agentx-demo
COGNEE_TIMEOUT_SECONDS=15.0
COGNEE_DATA_DIR=backend/app/knowledge/data
